# Copy this file to `.env` (or export these vars in your shell) and fill in real values.

# --- Email (Contact + Newsletter Subscribe) ---
# Gmail account that SENDS the email (and receives it by default).
# MAIL_PASS must be a Gmail "App Password" (Google Account > Security > 2-Step
# Verification > App passwords), NOT your normal login password.
MAIL_USER=makeindialab@gmail.com
MAIL_PASS=your_16_char_app_password

# Inbox that receives Contact + Subscribe emails (defaults to MAIL_USER).
MAIL_TO=makeindialab@gmail.com

# --- Google Sheets (Competition Registrations) ---
# The ID from the Google Sheet URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=your_sheet_id
# Range to append rows to. Column order: Timestamp, Name, Grade, Track, Stream, School, Email, Mobile, Project Idea
SHEET_RANGE=Sheet1!A:I

# Path to the service-account JSON key file (Google Cloud > IAM > Service Accounts).
# The service-account email must be given "Editor" access on the Google Sheet.
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json